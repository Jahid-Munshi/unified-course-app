# Environment Configuration for Unified Course App

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/unified_course_app?schema=public"

# NextAuth / Auth.js Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-jwt-key-min-32-chars"

# App Environment
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: External Search Engine (e.g. Meilisearch)
# MEILISEARCH_HOST="http://localhost:7700"
# MEILISEARCH_API_KEY="your-api-key"
